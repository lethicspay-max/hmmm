rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is corporate
    function isCorporate() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'corporate';
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if employee owns resource by email
    // (since employee's Firestore doc ID != Firebase Auth UID)
    function isEmployeeOwner(resourceEmployeeEmail) {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email == resourceEmployeeEmail;
    }

    // Users Collection
    match /users/{userId} {
      // Allow anyone to read corporate users (for public company pages)
      // Users can read their own profile
      // Admins can read any profile
      allow read: if (
        resource.data.role == 'corporate' ||
        (isAuthenticated() && (isOwner(userId) || isAdmin()))
      );

      // Allow users to create their own profile during registration
      // or admins can create any user profile
      allow create: if isAdmin() || (
        isAuthenticated() &&
        isOwner(userId) &&
        request.resource.data.role in ['corporate']
      );

      // Users can update their own profile (limited fields)
      // Admins can update any user
      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent users from changing their role or status
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
      );

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      // Anyone can read active products (for public company pages)
      allow read: if true;

      // Only admins can write products
      allow create, update, delete: if isAdmin();
    }

    // Corporate Settings Collection
    match /corporateSettings/{settingId} {
      // Anyone can read settings (for public company pages)
      // This allows employees to see their company's branding before logging in
      allow read: if true;

      // Only admins can write settings
      allow create, update, delete: if isAdmin();
    }

    // Corporate Product Settings Collection
    match /corporateProductSettings/{settingId} {
      // Anyone can read product settings (for public company pages)
      // This allows employees to see customized products before logging in
      allow read: if true;

      // Only admins can write product settings
      allow write: if isAdmin();
    }

    // Employees Collection
    match /employees/{employeeId} {
      // Anyone can read employees (needed for company subpage login/registration)
      // This allows employees to check if their email exists during authentication
      // SECURITY NOTE: Only non-sensitive data should be stored in employee records
      // since read access is public for authentication purposes
      allow read: if true;

      // Strict rules for employee creation:
      // 1. Admins can always create employees
      // 2. Corporate users can create employees under their account
      // 3. Self-registration on company pages (when corporateId matches existing corporate)
      allow create: if (
        isAdmin() ||
        (isCorporate() && request.resource.data.corporateId == request.auth.uid) ||
        // Allow self-registration only if corporateId exists and email is valid
        (
          request.resource.data.corporateId != null &&
          request.resource.data.email != null &&
          request.resource.data.name != null &&
          // Ensure points is non-negative
          request.resource.data.points >= 0 &&
          // Ensure status is set
          request.resource.data.status in ['active', 'inactive'] &&
          // Require timestamps
          request.resource.data.createdAt != null
        )
      );

      // Update rules for different scenarios:
      // 1. Admins can update any field
      // 2. Corporate users can update employees under their account
      // 3. Employees (after auth) can update LIMITED fields only
      // 4. During first-time setup: authenticated employee can update hasPassword field
      // 5. During order placement: employee can DECREASE their own points
      allow update: if isAuthenticated() && (
        // Admin can update everything
        isAdmin() ||
        // Corporate can update their employees
        (isCorporate() && resource.data.corporateId == request.auth.uid) ||
        // Employee updating their own record with restrictions (by email match)
        (
          request.auth.token.email == resource.data.email &&
          // Cannot change critical fields
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['corporateId', 'points', 'status', 'email']) &&
          // Can only update allowed fields: name, hasPassword, updatedAt
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'hasPassword', 'updatedAt'])
        ) ||
        // Special case: Employee setting hasPassword during first-time authentication
        // This matches by email since the employee's Firestore doc ID != Auth UID
        (
          request.auth.token.email == resource.data.email &&
          resource.data.hasPassword == false &&
          request.resource.data.hasPassword == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasPassword', 'updatedAt']) &&
          // Ensure they cannot change anything else during this operation
          request.resource.data.corporateId == resource.data.corporateId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.points == resource.data.points &&
          request.resource.data.status == resource.data.status
        ) ||
        // Special case: Employee spending points (order placement)
        // Employee can ONLY decrease points (not increase)
        (
          request.auth.token.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'updatedAt']) &&
          // Points must decrease (spending), not increase (cheating)
          request.resource.data.points < resource.data.points &&
          // Points cannot go negative
          request.resource.data.points >= 0 &&
          // Cannot change other fields
          request.resource.data.corporateId == resource.data.corporateId &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.hasPassword == resource.data.hasPassword
        )
      );

      // Admins and corporates can delete employees
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (isCorporate() && resource.data.corporateId == request.auth.uid)
      );
    }

    // Orders Collection
    match /orders/{orderId} {
      // Admins can read all orders
      // Corporates can read orders from their employees
      // Employees can read their own orders (matched by email)
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.corporateId == request.auth.uid ||
        isEmployeeOwner(resource.data.employeeEmail)
      );

      // Admins can create orders (for testing)
      // Employees can create orders for themselves (matched by email)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isEmployeeOwner(request.resource.data.employeeEmail)
      );

      // Only admins can update orders (status changes, etc.)
      allow update: if isAdmin();

      // Only admins can delete orders
      allow delete: if isAdmin();
    }

    // Tickets Collection
    match /tickets/{ticketId} {
      // Admins can read all tickets
      // Corporates can read tickets from their employees
      // Employees can read their own tickets (matched by email)
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.corporateId == request.auth.uid ||
        isEmployeeOwner(resource.data.employeeEmail)
      );

      // Anyone authenticated can create tickets
      allow create: if isAuthenticated();

      // Admins can update any ticket
      // Employees can update their own tickets (limited fields, matched by email)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isEmployeeOwner(resource.data.employeeEmail) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'createdAt']))
      );

      // Only admins can delete tickets
      allow delete: if isAdmin();
    }

    // Point Transactions Collection
    match /pointTransactions/{transactionId} {
      // Admins can read all transactions
      // Corporates can read transactions from their employees
      // Employees can read their own transactions (matched by email)
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.corporateId == request.auth.uid ||
        isEmployeeOwner(resource.data.employeeEmail)
      );

      // Admins and corporates can create transactions
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isCorporate() && request.resource.data.corporateId == request.auth.uid)
      );

      // Only admins can update transactions
      allow update: if isAdmin();

      // Only admins can delete transactions
      allow delete: if isAdmin();
    }

    // Contact Submissions Collection
    match /contactSubmissions/{submissionId} {
      // Only admins can read contact submissions
      allow read: if isAdmin();

      // Anyone can create contact submissions (for contact form)
      allow create: if true;

      // Only admins can update submissions
      allow update: if isAdmin();

      // Only admins can delete submissions
      allow delete: if isAdmin();
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
